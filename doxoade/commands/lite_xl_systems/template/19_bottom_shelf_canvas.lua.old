-- doxoade/commands/lite_xl_systems/template/19_bottom_shelf_canvas.lua
--[[
  🖥️ DOXOADE CONSOLE STUDIO, NATIVE SDL2 CANVAS & VARIABLE LINE-HEIGHT ENGINE (V18.1)
  - Declarado no topo: get_active_project_dir e extract_dox_image_info_from_line.
  - Imune a strict.lua: Zero chamadas a variáveis locais não-declaradas.
  - Terminal com 'cls' resiliente e suporte a PrintScreen direto.
]]
local core = require "core"
local DocView = require "core.docview"
local RootView = require "core.rootview"
local command = require "core.command"
local keymap = require "core.keymap"
local style = require "core.style"
local config = require "core.config"

-- =============================================================================
-- 1. UTILITÁRIOS BASE (Declarados Primeiro para Visibilidade Global no Módulo)
-- =============================================================================
local rencache = rawget(_G, "rencache") or (pcall(require, "core.rencache") and require("core.rencache") or nil)
local native_renderer = rawget(_G, "renderer") or (pcall(require, "renderer") and require("renderer") or nil)

local function draw_rect_safe(x, y, w, h, color)
  if rencache and rencache.draw_rect then rencache.draw_rect(x, y, w, h, color)
  elseif native_renderer and native_renderer.draw_rect then native_renderer.draw_rect(x, y, w, h, color) end
end

local function draw_text_safe(font, text, x, y, color)
  if rencache and rencache.draw_text then rencache.draw_text(font, text, x, y, color)
  elseif native_renderer and native_renderer.draw_text then native_renderer.draw_text(font, text, x, y, color) end
end

local function get_active_project_dir()
  if core.project_directories and #core.project_directories > 0 then
    local p = core.project_directories[1]
    return tostring(type(p) == "table" and (p.path or p.name) or p)
  end
  return core.project_dir or "."
end

local function detect_project_venv(proj_dir)
  local sep = PATHSEP or "/"
  local candidates = {
    proj_dir .. sep .. "venv",
    proj_dir .. sep .. ".venv",
    proj_dir .. sep .. "env",
    proj_dir .. sep .. ".env",
  }
  for _, vpath in ipairs(candidates) do
    local info = system.get_file_info(vpath)
    if info and info.type == "dir" then
      local scripts = (PLATFORM == "Windows") and (vpath .. sep .. "Scripts") or (vpath .. sep .. "bin")
      if system.get_file_info(scripts) then
        return scripts, vpath
      end
    end
  end
  return nil, nil
end

local function extract_dox_image_info_from_line(line_text)
  if not line_text or line_text == "" then return nil end
  if not line_text:find("DOX%-IMG") and not line_text:find("%.doxoade/assets/images") then
    return nil
  end

  local fn, res, dt = line_text:match("%[DOX%-IMG:([%w_]+%.png)%s*|?%s*([^|%]]*)%s*|?%s*([^%]]*)%]")
  if fn then
    return { filename = fn, resolution = (res ~= "" and res) or "HD", date = (dt ~= "" and dt) or "Recente" }
  end

  local md_fn = line_text:match("!%[[^%]]*%]%(%.doxoade/assets/images/([%w_]+%.png)")
  if md_fn then
    return { filename = md_fn, resolution = "HD", date = "Markdown" }
  end
  return nil
end

-- =============================================================================
-- 2. CACHE DE METADADOS DE IMAGEM & CARD HEIGHT
-- =============================================================================
local _image_meta_cache = {}
local CARD_HEIGHT = 160

local function load_image_meta(filename)
  if _image_meta_cache[filename] then return _image_meta_cache[filename] end
  local proj_dir = get_active_project_dir()
  local sep = PATHSEP or "/"
  local meta_path = proj_dir .. sep .. ".doxoade" .. sep .. "assets" .. sep .. "images" .. sep .. filename:gsub("%.png$", ".meta.json")

  local f = io.open(meta_path, "r")
  if f then
    local content = f:read("*a")
    f:close()
    pcall(function()
      local tw = tonumber(content:match('"thumb_w"%s*:%s*(%d+)')) or 60
      local th = tonumber(content:match('"thumb_h"%s*:%s*(%d+)')) or 30
      _image_meta_cache[filename] = {
        thumb_w = tw,
        thumb_h = th,
        meta_path = meta_path,
        loaded = true
      }
    end)
  end
  return _image_meta_cache[filename]
end

-- =============================================================================
-- 3. GEOMETRIA DINÂMICA (DocView)
-- =============================================================================
local function get_line_extra_height(doc, line_idx)
  if not doc or not doc.lines or not doc.lines[line_idx] then return 0 end
  local info = extract_dox_image_info_from_line(doc.lines[line_idx])
  if info then
    return CARD_HEIGHT + 10
  end
  return 0
end

local original_get_line_screen_position = DocView.get_line_screen_position
function DocView:get_line_screen_position(line, col)
  local x, y = self:get_content_offset()
  local lh = self:get_line_height()
  local gw = self:get_gutter_width()

  local extra_y = 0
  if self.doc and self.doc.lines then
    for i = 1, math.min(#self.doc.lines, line - 1) do
      extra_y = extra_y + get_line_extra_height(self.doc, i)
    end
  end

  local base_x = x + gw
  local base_y = y + (line - 1) * lh + extra_y + style.padding.y

  if col then
    local cx = base_x + self:get_col_x_offset(line, col)
    return cx, base_y
  end
  return base_x, base_y
end

local original_draw_line_body = DocView.draw_line_body
function DocView:draw_line_body(line_idx, x, y)
  local text_h = original_draw_line_body(self, line_idx, x, y)
  local doc = self.doc
  if doc and doc.lines and doc.lines[line_idx] then
    local img_info = extract_dox_image_info_from_line(doc.lines[line_idx])
    if img_info then
      local card_y = y + self:get_line_height() + 4
      local card_w = math.min(520, self.size.x - x - 40)
      local card_h = CARD_HEIGHT
      local font = style.font or style.code_font

      draw_rect_safe(x, card_y, card_w, card_h, style.background2 or { 30, 28, 33, 255 })
      draw_rect_safe(x, card_y, 3, card_h, style.accent or { 38, 188, 95, 255 })
      draw_rect_safe(x, card_y + card_h - 1, card_w, 1, style.divider or { 60, 55, 65, 255 })

      local header_title = string.format("🖼️ %s  (%s)", img_info.filename, img_info.resolution)
      draw_text_safe(font, header_title, x + 12, card_y + 8, style.accent or { 56, 189, 248, 255 })
      draw_text_safe(font, img_info.date, x + card_w - font:get_width(img_info.date) - 12, card_y + 8, style.dim)

      local preview_x = x + 12
      local preview_y = card_y + 30
      local preview_w = card_w - 24
      local preview_h = card_h - 40
      draw_rect_safe(preview_x, preview_y, preview_w, preview_h, { 18, 17, 20, 255 })

      local meta = load_image_meta(img_info.filename)
      if meta and meta.loaded then
        local box_w = math.min(preview_w - 20, 240)
        local box_h = preview_h - 16
        local bx = preview_x + (preview_w - box_w) / 2
        local by = preview_y + 8
        draw_rect_safe(bx, by, box_w, box_h, { 35, 38, 46, 255 })
        draw_rect_safe(bx + 2, by + 2, box_w - 4, box_h - 4, { 25, 26, 32, 255 })
        local label = "[ Preview CAS Ativo • Clique para Expandir ]"
        local lw = font:get_width(label)
        draw_text_safe(font, label, bx + (box_w - lw) / 2, by + (box_h - font:get_height()) / 2, style.dim)
      else
        local loading_txt = "Carregando metadados CAS..."
        draw_text_safe(font, loading_txt, preview_x + 16, preview_y + 16, style.dim)
      end
    end
  end
  return text_h
end

-- =============================================================================
-- 4. TABELA DE CORES ANSI
-- =============================================================================
local ANSI_PALETTE = {
  [30] = { 20, 20, 20, 255 }, [31] = { 239, 68, 68, 255 }, [32] = { 34, 197, 94, 255 },
  [33] = { 234, 179, 8, 255 }, [34] = { 59, 130, 246, 255 }, [35] = { 168, 85, 247, 255 },
  [36] = { 6, 182, 212, 255 }, [37] = { 230, 230, 230, 255 },
  [90] = { 115, 115, 115, 255 }, [91] = { 248, 113, 113, 255 }, [92] = { 74, 222, 128, 255 },
  [93] = { 250, 204, 21, 255 }, [94] = { 96, 165, 250, 255 }, [95] = { 192, 132, 252, 255 },
  [96] = { 34, 211, 238, 255 }, [97] = { 255, 255, 255, 255 },
}

local function parse_ansi_segments(raw_line, default_fg)
  default_fg = default_fg or { 230, 230, 230, 255 }
  if not raw_line or raw_line == "" then return { { text = "", fg = default_fg } } end
  if not raw_line:find("\x1b%[") then return { { text = raw_line, fg = default_fg } } end

  local segments = {}
  local current_fg = default_fg
  local pos = 1
  local len = #raw_line

  while pos <= len do
    local s, e, code_str = raw_line:find("\x1b%[([%d;]*)m", pos)
    if s then
      if s > pos then
        table.insert(segments, { text = raw_line:sub(pos, s - 1), fg = current_fg })
      end
      if code_str == "" or code_str == "0" then
        current_fg = default_fg
      else
        for c in code_str:gmatch("%d+") do
          local n = tonumber(c)
          if ANSI_PALETTE[n] then current_fg = ANSI_PALETTE[n] end
        end
      end
      pos = e + 1
    else
      table.insert(segments, { text = raw_line:sub(pos), fg = current_fg })
      break
    end
  end
  return #segments > 0 and segments or { { text = raw_line, fg = default_fg } }
end

-- =============================================================================
-- 5. PAINEL FLUTUANTE (TERMINAL & CANVAS)
-- =============================================================================
local FloatingPanel = {
  visible = false,
  is_maximized = false,
  header_height = 30,
  active_mode = "terminal",
  hovered_tab = nil,
  hovered_btn = nil,
  hovered_close = false,
  is_executing = false,
  scroll_y = 0,
  scroll_to_y = 0,
  input_text = "",
  input_cursor = 1,
  history = {},
  history_idx = 1,
  terminal_lines = {},
  term_font_size = 14,
  term_font = nil,
  canvas_rects = {},
  canvas_grid_w = 0,
  canvas_grid_h = 0,
  canvas_image_path = nil,
  canvas_zoom = 1.0,
  canvas_pan_x = 0,
  canvas_pan_y = 0,
  is_panning = false,
  image_status_msg = "Nenhum print carregado. Pressione Ctrl+V para colar.",
  tabs = {
    { id = "terminal", label = "Terminal (Venv)" },
    { id = "canvas",   label = "Canvas SDL2 (Prints)" },
  },
  action_buttons = {},
}

rawset(_G, "_DOXOADE_FLOATING_PANEL", FloatingPanel)

function FloatingPanel:get_terminal_font()
  if not self.term_font or self.term_font:get_size() ~= self.term_font_size then
    local base = style.code_font or style.font
    if base and base.copy then
      self.term_font = base:copy(self.term_font_size)
    else
      self.term_font = base
    end
  end
  return self.term_font or style.font
end

function FloatingPanel:clear_screen()
  self.terminal_lines = {}
  self.scroll_y = 0
  self.scroll_to_y = 0
  self:init_welcome()
  core.redraw = true
end

function FloatingPanel:init_welcome()
  local proj = get_active_project_dir()
  local _, venv_root = detect_project_venv(proj)
  local venv_status = venv_root and ("\x1b[32m✔ " .. venv_root:match("[^/\\]+$") .. "\x1b[0m") or "\x1b[33m(Nenhum venv local)\x1b[0m"

  local banner_lines = {
    "\x1b[90m================================================================================\x1b[0m",
    "  \x1b[38;2;0;108;255mDOXOADE\x1b[0m \x1b[38;2;38;188;95mCONSOLE STUDIO\x1b[0m \x1b[90m(V18.1 Zero-Freeze)\x1b[0m",
    "  \x1b[36mProjeto\x1b[0m : \x1b[37m" .. proj .. "\x1b[0m",
    "  \x1b[36mVenv   \x1b[0m : " .. venv_status,
    "  \x1b[90mAtalhos: cls (Limpar) | Ctrl+V (Colar Print no Canvas)\x1b[0m",
    "\x1b[90m================================================================================\x1b[0m",
    ""
  }
  for _, line in ipairs(banner_lines) do
    table.insert(self.terminal_lines, { segments = parse_ansi_segments(line) })
  end
end

FloatingPanel:init_welcome()

function FloatingPanel:paste_clipboard_image()
  local user_dir = USERDIR or "."
  local sep = PATHSEP or "/"
  local cache_dir = user_dir .. sep .. ".doxoade" .. sep .. "canvas_cache"
  pcall(function() system.mkdir(cache_dir) end)

  local rle_out = cache_dir .. sep .. "clipboard_rle.dat"
  local log_out = cache_dir .. sep .. "clip_bridge.log"
  local script_py = cache_dir .. sep .. "clip_bridge.py"

  pcall(os.remove, log_out)
  pcall(os.remove, rle_out)

  local py_code = [[
import sys, os, time, json, platform
from io import BytesIO
from pathlib import Path

def get_clipboard_image():
    try:
        from PIL import ImageGrab, Image
        for _ in range(3):
            img = ImageGrab.grabclipboard()
            if isinstance(img, Image.Image): return img
            elif isinstance(img, list) and len(img) > 0:
                p = Path(img[0])
                if p.is_file(): return Image.open(p)
            time.sleep(0.05)
    except Exception: pass

    if platform.system() == "Windows":
        try:
            import ctypes
            from PIL import Image
            user32, kernel32 = ctypes.windll.user32, ctypes.windll.kernel32
            for _ in range(3):
                if user32.OpenClipboard(None):
                    CF_DIB = 8; CF_DIBV5 = 17
                    h_data = user32.GetClipboardData(CF_DIB) or user32.GetClipboardData(CF_DIBV5)
                    if h_data:
                        p_data = kernel32.GlobalLock(h_data)
                        size = kernel32.GlobalSize(h_data)
                        if p_data and size > 0:
                            import struct
                            raw_bytes = ctypes.string_at(p_data, size)
                            kernel32.GlobalUnlock(h_data)
                            user32.CloseClipboard()
                            header_size = struct.unpack("<I", raw_bytes[0:4])[0]
                            file_header = struct.pack("<2sIHHI", b"BM", 14 + size, 0, 0, 14 + header_size)
                            return Image.open(BytesIO(file_header + raw_bytes))
                    user32.CloseClipboard()
                time.sleep(0.05)
        except Exception: pass
    return None

def generate_rle_rects(img):
    img = img.convert("RGB")
    orig_w, orig_h = img.size
    target_w, target_h = orig_w, orig_h
    if target_w > 1920:
        scale = 1920 / target_w
        target_w = 1920
        target_h = int(target_h * scale)
        img = img.resize((target_w, target_h))
    pixels = img.load()
    rects = []
    for y in range(target_h):
        run_start_x = 0
        cur_color = pixels[0, y]
        run_len = 1
        for x in range(1, target_w):
            c = pixels[x, y]
            if c == cur_color:
                run_len += 1
            else:
                rects.append(f"{run_start_x},{y},{run_len},{cur_color[0]},{cur_color[1]},{cur_color[2]}")
                run_start_x = x; cur_color = c; run_len = 1
        rects.append(f"{run_start_x},{y},{run_len},{cur_color[0]},{cur_color[1]},{cur_color[2]}")
    return rects, target_w, target_h

def main():
    if len(sys.argv) < 4: sys.exit(1)
    dest_png, dest_meta, rle_file = sys.argv[1], sys.argv[2], sys.argv[3]
    img = get_clipboard_image()
    if not img:
        print("[ERRO] Clipboard vazio.")
        sys.exit(1)
    img.save(dest_png, format="PNG")
    meta = { "width": img.size[0], "height": img.size[1], "platform": platform.system() }
    with open(dest_meta, "w", encoding="utf-8") as f: json.dump(meta, f, indent=2)
    rects, gw, gh = generate_rle_rects(img)
    with open(rle_file, "w", encoding="utf-8") as f:
        f.write(f"{gw},{gh}\n")
        f.write("\n".join(rects))
    print(f"[OK] {img.size[0]}|{img.size[1]}")
    sys.exit(0)

if __name__ == "__main__": main()
]]

  local f_py = io.open(script_py, "w")
  if f_py then f_py:write(py_code); f_py:close() end

  self.image_status_msg = "Capturando PrintScreen..."
  core.redraw = true

  local proj = get_active_project_dir()
  local assets_dir = proj .. sep .. ".doxoade" .. sep .. "assets" .. sep .. "images"
  pcall(function() system.mkdir(proj .. sep .. ".doxoade") end)
  pcall(function() system.mkdir(proj .. sep .. ".doxoade" .. sep .. "assets") end)
  pcall(function() system.mkdir(assets_dir) end)

  local ts = os.date("%Y%m%d_%H%M%S")
  local dest_png = assets_dir .. sep .. "print_" .. ts .. ".png"
  local dest_meta = assets_dir .. sep .. "print_" .. ts .. ".meta.json"

  local venv_scripts, _ = detect_project_venv(proj)
  local py_exe = (venv_scripts and (venv_scripts .. (PLATFORM == "Windows" and "\\python.exe" or "/python"))) or "python"

  core.add_thread(function()
    local cmd = string.format('"%s" "%s" "%s" "%s" "%s" > "%s" 2>&1',
      py_exe, script_py, dest_png, dest_meta, rle_out, log_out)
    if PLATFORM == "Windows" then
      cmd = 'cmd.exe /c ""' .. py_exe .. '" "' .. script_py .. '" "' .. dest_png .. '" "' .. dest_meta .. '" "' .. rle_out .. '" > "' .. log_out .. '" 2>&1"'
    end
    pcall(system.exec, cmd)

    for _ = 1, 30 do
      coroutine.yield(0.05)
      local finfo = system.get_file_info(rle_out)
      if finfo and (finfo.size or 0) > 0 then break end
    end

    local f_rle = io.open(rle_out, "r")
    if f_rle then
      local header = f_rle:read("*l") or "1366,768"
      local gw, gh = header:match("^(%d+),(%d+)$")
      FloatingPanel.canvas_grid_w = tonumber(gw) or 1366
      FloatingPanel.canvas_grid_h = tonumber(gh) or 768
      FloatingPanel.canvas_rects = {}
      for line in f_rle:lines() do
        local rx, ry, rw, r, g, b = line:match("^(%d+),(%d+),(%d+),(%d+),(%d+),(%d+)$")
        if rx then
          table.insert(FloatingPanel.canvas_rects, {
            x = tonumber(rx), y = tonumber(ry), w = tonumber(rw),
            color = { tonumber(r), tonumber(g), tonumber(b), 255 }
          })
        end
      end
      f_rle:close()
      FloatingPanel.canvas_image_path = dest_png
      FloatingPanel.active_mode = "canvas"
      FloatingPanel.image_status_msg = string.format("Print Salvo: print_%s.png (%dx%d px)", ts, FloatingPanel.canvas_grid_w, FloatingPanel.canvas_grid_h)
      core.log("✔ PrintScreen colado e salvo em: .doxoade/assets/images/print_" .. ts .. ".png")
    else
      FloatingPanel.image_status_msg = "Nenhuma imagem encontrada no clipboard."
      core.log("⚠ Clipboard vazio. Use Win+Shift+S para tirar um print.")
    end
    core.redraw = true
  end)
end

function FloatingPanel:execute_command(raw_cmd)
  if not raw_cmd or raw_cmd:match("^%s*$") then return end
  local cmd_str = raw_cmd:gsub("^%s*", ""):gsub("%s*$", "")

  if cmd_str:lower() == "cls" or cmd_str:lower() == "clear" then
    self.input_text = ""
    self.input_cursor = 1
    self:clear_screen()
    return
  end

  table.insert(self.terminal_lines, {
    segments = {
      { text = "> ", fg = style.accent or { 38, 188, 95, 255 } },
      { text = cmd_str, fg = { 255, 255, 255, 255 } }
    }
  })

  self.input_text = ""
  self.input_cursor = 1
  self.is_executing = true
  core.redraw = true

  local proj = get_active_project_dir()
  local venv_scripts, venv_dir = detect_project_venv(proj)
  local safe_scripts = venv_scripts or ""
  local safe_venv_root = venv_dir or ""

  core.add_thread(function()
    local user_dir = USERDIR or "."
    local sep = PATHSEP or "/"
    local out_tmp = user_dir .. sep .. ".doxoade" .. sep .. "terminal_stdout.tmp"
    pcall(os.remove, out_tmp)

    local run_cmd
    if PLATFORM == "Windows" then
      if safe_scripts ~= "" then
        run_cmd = string.format('cmd.exe /c "set "PATH=%s;%%PATH%%" & set "VIRTUAL_ENV=%s" & cd /d "%s" & %s > "%s" 2>&1 & echo:__DOXOADE_EOF__ >> "%s""',
          safe_scripts, safe_venv_root, proj, cmd_str, out_tmp, out_tmp)
      else
        run_cmd = string.format('cmd.exe /c "cd /d "%s" & %s > "%s" 2>&1 & echo:__DOXOADE_EOF__ >> "%s""',
          proj, cmd_str, out_tmp, out_tmp)
      end
    else
      if safe_scripts ~= "" then
        run_cmd = string.format('sh -c "export PATH=\'%s:$PATH\'; export VIRTUAL_ENV=\'%s\'; cd \'%s\'; %s > \'%s\' 2>&1; echo \'__DOXOADE_EOF__\' >> \'%s\'"',
          safe_scripts, safe_venv_root, proj, cmd_str, out_tmp, out_tmp)
      else
        run_cmd = string.format('sh -c "cd \'%s\'; %s > \'%s\' 2>&1; echo \'__DOXOADE_EOF__\' >> \'%s\'"',
          proj, cmd_str, out_tmp, out_tmp)
      end
    end

    pcall(system.exec, run_cmd)

    local last_pos = 0
    for _ = 1, 100 do
      coroutine.yield(0.08)
      local f = io.open(out_tmp, "r")
      if f then
        f:seek("set", last_pos)
        local chunk = f:read("*a")
        if chunk and chunk ~= "" then
          chunk = chunk:gsub("__DOXOADE_EOF__[\r\n]*", "")
          for line in chunk:gmatch("([^\r\n]*)\r?\n?") do
            if line ~= "" then
              table.insert(FloatingPanel.terminal_lines, { segments = parse_ansi_segments(line) })
            end
          end
          last_pos = f:seek()
          local font = FloatingPanel:get_terminal_font()
          local line_h = font:get_height() + 2
          FloatingPanel.scroll_to_y = math.max(0, (#FloatingPanel.terminal_lines * line_h) - 250)
          core.redraw = true
        end
        f:close()
        if chunk and chunk:find("__DOXOADE_EOF__") then break end
      end
    end

    FloatingPanel.is_executing = false
    core.redraw = true
  end)
end

function FloatingPanel:draw()
  if not self.visible then return end
  local font = self:get_terminal_font()
  local screen_w = core.root_view.size.x
  local screen_h = core.root_view.size.y

  draw_rect_safe(0, 0, screen_w, screen_h, { 0, 0, 0, 180 })

  local x, y, w, h
  if self.is_maximized then
    x, y, w, h = 8, 8, screen_w - 16, screen_h - 16
  else
    w = math.min(screen_w - 24, math.max(850, math.floor(screen_w * 0.88)))
    h = math.min(screen_h - 24, math.max(540, math.floor(screen_h * 0.84)))
    x = math.floor((screen_w - w) / 2)
    y = math.floor((screen_h - h) / 2)
  end

  self.card_rect = { x = x, y = y, w = w, h = h }

  draw_rect_safe(x - 6, y - 6, w + 12, h + 12, { 0, 0, 0, 120 })
  draw_rect_safe(x, y, w, h, { 0, 0, 0, 255 })
  draw_rect_safe(x, y, w, 2, style.accent or { 38, 188, 95, 255 })

  draw_rect_safe(x, y + 2, w, self.header_height, { 16, 16, 16, 255 })
  draw_rect_safe(x, y + self.header_height + 1, w, 1, { 35, 35, 35, 255 })

  -- Abas
  local tab_x = x + 12
  for i, tab in ipairs(self.tabs) do
    local is_active = (self.active_mode == tab.id)
    local is_hovered = (self.hovered_tab == i)
    local tab_w = font:get_width(tab.label) + 18
    local tab_h = self.header_height - 6

    if is_active then
      draw_rect_safe(tab_x, y + 4, tab_w, tab_h, { 0, 0, 0, 255 })
      draw_rect_safe(tab_x, y + 4, tab_w, 2, style.accent or { 38, 188, 95, 255 })
    elseif is_hovered then
      draw_rect_safe(tab_x, y + 4, tab_w, tab_h, { 30, 30, 30, 255 })
    end

    local text_color = is_active and (style.accent or { 38, 188, 95, 255 }) or { 150, 150, 150, 255 }
    draw_text_safe(font, tab.label, tab_x + 9, y + 7, text_color)
    tab.rect = { x = tab_x, y = y + 4, w = tab_w, h = tab_h }
    tab_x = tab_x + tab_w + 6
  end

  -- Botão Fechar [X]
  local close_w = 22
  local close_x = x + w - close_w - 10
  local close_y = y + 4
  if self.hovered_close then
    draw_rect_safe(close_x, close_y, close_w, self.header_height - 6, { 200, 50, 50, 200 })
  end
  draw_text_safe(font, "[X]", close_x + 2, close_y + 3, self.hovered_close and { 255, 255, 255, 255 } or { 150, 150, 150, 255 })
  self.close_rect = { x = close_x, y = close_y, w = close_w, h = self.header_height - 6 }

  -- Conteúdo
  local canvas_y = y + self.header_height + 2
  local canvas_h = h - self.header_height - 34

  core.push_clip_rect(x + 2, canvas_y, w - 4, canvas_h)

  if self.active_mode == "canvas" then
    if #self.canvas_rects > 0 then
      local gw = self.canvas_grid_w or 1366
      local gh = self.canvas_grid_h or 768
      local base_pixel_scale = math.min((w - 40) / gw, (canvas_h - 40) / gh)
      local pixel_size = math.max(1, base_pixel_scale * self.canvas_zoom)
      local total_drawn_w = math.floor(gw * pixel_size)
      local total_drawn_h = math.floor(gh * pixel_size)
      local start_draw_x = x + math.floor((w - total_drawn_w) / 2) + self.canvas_pan_x
      local start_draw_y = canvas_y + math.floor((canvas_h - total_drawn_h) / 2) + self.canvas_pan_y

      draw_rect_safe(start_draw_x - 2, start_draw_y - 2, total_drawn_w + 4, total_drawn_h + 4, { 5, 5, 5, 255 })
      for _, r in ipairs(self.canvas_rects) do
        local rx = start_draw_x + math.floor(r.x * pixel_size)
        local ry = start_draw_y + math.floor(r.y * pixel_size)
        local rw = math.max(1, math.ceil(r.w * pixel_size))
        local rh = math.max(1, math.ceil(pixel_size))
        if rx + rw >= x and rx <= x + w and ry + rh >= canvas_y and ry <= canvas_y + canvas_h then
          draw_rect_safe(rx, ry, rw, rh, r.color)
        end
      end
    else
      local empty_box_w = math.min(560, w - 80)
      local empty_box_h = 160
      local e_x = x + math.floor((w - empty_box_w) / 2)
      local e_y = canvas_y + math.floor((canvas_h - empty_box_h) / 2)
      draw_rect_safe(e_x, e_y, empty_box_w, empty_box_h, { 14, 14, 14, 255 })
      draw_rect_safe(e_x, e_y, empty_box_w, 2, style.accent or { 38, 188, 95, 255 })
      draw_text_safe(font, "CANVAS NATIVO SDL2 (Prints & Clipboard)", e_x + 20, e_y + 24, style.accent)
      draw_text_safe(font, "• Tire um print com Win+Shift+S ou PrintScreen.", e_x + 20, e_y + 54, { 230, 230, 230, 255 })
      draw_text_safe(font, "• Pressione Ctrl+V para renderizar a imagem aqui.", e_x + 20, e_y + 78, { 56, 189, 248, 255 })
      draw_text_safe(font, "• Use a roda do mouse para Zoom e clique para arrastar.", e_x + 20, e_y + 102, { 150, 150, 150, 255 })
    end
  elseif self.active_mode == "terminal" then
    local line_h = font:get_height() + 2
    local cur_y = canvas_y + 6 - self.scroll_y

    for line_idx, item in ipairs(self.terminal_lines) do
      if cur_y + line_h > canvas_y and cur_y < canvas_y + canvas_h then
        local seg_x = x + 14
        for _, seg in ipairs(item.segments or {}) do
          draw_text_safe(font, seg.text, seg_x, cur_y, seg.fg)
          seg_x = seg_x + font:get_width(seg.text)
        end
      end
      cur_y = cur_y + line_h
    end
  end

  core.pop_clip_rect()

  -- Rodapé
  if self.active_mode == "terminal" then
    local input_y = y + h - 30
    draw_rect_safe(x + 1, input_y, w - 2, 29, { 10, 10, 10, 255 })
    draw_rect_safe(x + 1, input_y, w - 2, 1, style.accent or { 38, 188, 95, 255 })

    local tag_venv = self.is_executing and "[RODANDO]" or "[TERMINAL]"
    local tag_col = self.is_executing and { 251, 191, 36, 255 } or (style.accent or { 38, 188, 95, 255 })
    draw_text_safe(font, tag_venv, x + 14, input_y + 6, tag_col)

    local prompt_offset = font:get_width(tag_venv) + 24
    draw_text_safe(font, "> " .. self.input_text, x + prompt_offset, input_y + 6, { 255, 255, 255, 255 })

    local text_before = self.input_text:sub(1, self.input_cursor - 1)
    local cur_pixel_x = x + prompt_offset + font:get_width("> " .. text_before)
    draw_rect_safe(cur_pixel_x, input_y + 6, 2, font:get_height(), style.accent or { 38, 188, 95, 255 })
  else
    local info_y = y + h - 26
    draw_rect_safe(x + 1, info_y, w - 2, 25, { 12, 12, 12, 255 })
    draw_rect_safe(x + 1, info_y, w - 2, 1, { 35, 35, 35, 255 })
    local zoom_label = string.format("[Zoom: %d%%] ", math.floor(self.canvas_zoom * 100))
    draw_text_safe(font, zoom_label, x + 14, info_y + 5, style.accent or { 38, 188, 95, 255 })
    draw_text_safe(font, self.image_status_msg, x + 14 + font:get_width(zoom_label), info_y + 5, { 150, 150, 150, 255 })
  end
end

-- =============================================================================
-- 6. EVENTOS E COMANDOS
-- =============================================================================
local original_rootview_draw = RootView.draw
function RootView:draw(...)
  original_rootview_draw(self, ...)
  if FloatingPanel.visible then FloatingPanel:draw() end
end

local original_rootview_on_mouse_moved = RootView.on_mouse_moved
function RootView:on_mouse_moved(x, y, dx, dy)
  if FloatingPanel.visible then
    local r = FloatingPanel.card_rect
    FloatingPanel.hovered_tab = nil
    FloatingPanel.hovered_close = false

    if FloatingPanel.is_panning and FloatingPanel.active_mode == "canvas" then
      FloatingPanel.canvas_pan_x = FloatingPanel.canvas_pan_x + dx
      FloatingPanel.canvas_pan_y = FloatingPanel.canvas_pan_y + dy
      core.redraw = true
      return
    end

    if r and x >= r.x and x <= r.x + r.w and y >= r.y and y <= r.y + r.h then
      for i, tab in ipairs(FloatingPanel.tabs) do
        if tab.rect and x >= tab.rect.x and x <= tab.rect.x + tab.rect.w and
           y >= tab.rect.y and y <= tab.rect.y + tab.rect.h then
          FloatingPanel.hovered_tab = i; core.redraw = true; return
        end
      end
      if FloatingPanel.close_rect and x >= FloatingPanel.close_rect.x and x <= FloatingPanel.close_rect.x + FloatingPanel.close_rect.w and
         y >= FloatingPanel.close_rect.y and y <= FloatingPanel.close_rect.y + FloatingPanel.close_rect.h then
        FloatingPanel.hovered_close = true
        core.redraw = true
        return
      end
    end
    core.redraw = true
    return
  end
  if original_rootview_on_mouse_moved then
    return original_rootview_on_mouse_moved(self, x, y, dx, dy)
  end
end

local original_rootview_on_mouse_pressed = RootView.on_mouse_pressed
function RootView:on_mouse_pressed(button, x, y, clicks)
  if FloatingPanel.visible then
    local r = FloatingPanel.card_rect
    if r and (x < r.x or x > r.x + r.w or y < r.y or y > r.y + r.h) then
      FloatingPanel.visible = false
      core.redraw = true
      return true
    end
    for i, tab in ipairs(FloatingPanel.tabs) do
      if tab.rect and x >= tab.rect.x and x <= tab.rect.x + tab.rect.w and
         y >= tab.rect.y and y <= tab.rect.y + tab.rect.h then
        FloatingPanel.active_mode = tab.id
        core.redraw = true
        return true
      end
    end
    if FloatingPanel.hovered_close then
      FloatingPanel.visible = false
      core.redraw = true
      return true
    end
    if FloatingPanel.active_mode == "canvas" and (button == "left" or button == 1) then
      FloatingPanel.is_panning = true
      return true
    end
    return true
  end
  if original_rootview_on_mouse_pressed then
    return original_rootview_on_mouse_pressed(self, button, x, y, clicks)
  end
end

local original_rootview_on_mouse_released = RootView.on_mouse_released
function RootView:on_mouse_released(button, x, y)
  if FloatingPanel.visible then
    FloatingPanel.is_panning = false
    core.redraw = true
    return true
  end
  if original_rootview_on_mouse_released then
    return original_rootview_on_mouse_released(self, button, x, y)
  end
end

local original_rootview_on_text_input = RootView.on_text_input
function RootView:on_text_input(text)
  if FloatingPanel.visible and FloatingPanel.active_mode == "terminal" then
    FloatingPanel.input_text = FloatingPanel.input_text:sub(1, FloatingPanel.input_cursor - 1) .. text .. FloatingPanel.input_text:sub(FloatingPanel.input_cursor)
    FloatingPanel.input_cursor = FloatingPanel.input_cursor + #text
    core.redraw = true
    return true
  end
  return original_rootview_on_text_input(self, text)
end

command.add(nil, {
  ["doxoade:toggle-bottom-shelf"] = function()
    FloatingPanel.visible = not FloatingPanel.visible
    core.redraw = true
    core.log(FloatingPanel.visible and "🖥️ Terminal Console aberto." or "🖥️ Terminal Console recolhido.")
  end,
})

command.add(function() return FloatingPanel.visible end, {
  ["bottom-shelf:paste-action"] = function()
    if FloatingPanel.active_mode == "canvas" then
      FloatingPanel:paste_clipboard_image()
    elseif FloatingPanel.active_mode == "terminal" then
      local clip = (system.get_clipboard and system.get_clipboard()) or ""
      if clip and clip ~= "" then
        clip = clip:gsub("[\r\n]+", " ")
        FloatingPanel.input_text = FloatingPanel.input_text:sub(1, FloatingPanel.input_cursor - 1) .. clip .. FloatingPanel.input_text:sub(FloatingPanel.input_cursor)
        FloatingPanel.input_cursor = FloatingPanel.input_cursor + #clip
        core.redraw = true
      end
    end
    return true
  end,
  ["bottom-shelf:close"] = function()
    FloatingPanel.visible = false
    core.redraw = true
    return true
  end,
  ["bottom-shelf:submit"] = function()
    if not FloatingPanel.is_executing then
      FloatingPanel:execute_command(FloatingPanel.input_text)
    end
    return true
  end,
  ["bottom-shelf:backspace"] = function()
    if FloatingPanel.input_cursor > 1 then
      FloatingPanel.input_text = FloatingPanel.input_text:sub(1, FloatingPanel.input_cursor - 2) .. FloatingPanel.input_text:sub(FloatingPanel.input_cursor)
      FloatingPanel.input_cursor = FloatingPanel.input_cursor - 1
      core.redraw = true
    end
    return true
  end,
})

keymap.add {
  ["ctrl+`"]        = "doxoade:toggle-bottom-shelf",
  ["escape"]        = "bottom-shelf:close",
  ["ctrl+v"]        = "bottom-shelf:paste-action",
  ["return"]        = "bottom-shelf:submit",
  ["keypad enter"]  = "bottom-shelf:submit",
  ["backspace"]     = "bottom-shelf:backspace",
}
