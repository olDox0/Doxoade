+def _kill_orphan_pty_daemons() -> int:
+    """Mata python.exe orfãos do pty_file_daemon (filhos do Lite XL morto).
+
+    Retorna quantos processos foram mortos (0 se nenhum).
+    """
+    if sys.platform != "win32":
+        try:
+            r = subprocess.run(
+                ["pkill", "-f", "pty_file_daemon"],
+                capture_output=True, timeout=5
+            )
+            return 0 if r.returncode != 0 else 1
+        except Exception:
+            return 0
+
+    ps = (
+        "Get-CimInstance Win32_Process -Filter \"Name='python.exe'\" "
+        "| Where-Object { $_.CommandLine -match 'pty_file_daemon' } "
+        "| ForEach-Object { "
+        "    try { Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop; Write-Output $_.ProcessId } "
+        "    catch {} "
+        "}"
+    )
+    try:
+        r = subprocess.run(
+            ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
+            capture_output=True, text=True, timeout=15
+        )
+        killed = sum(1 for ln in r.stdout.splitlines() if ln.strip().isdigit())
+        return killed
+    except Exception:
+        return 0
+
+
+def _move_with_robocopy(src: Path, dst: Path, retries: int = 8) -> Tuple[bool, str]:
+    """Move src → dst. Windows: robocopy /MOVE (retry robusto + log).
+    POSIX: shutil.move. Retorna (ok, erro).
+    """
+    if sys.platform != "win32":
+        try:
+            shutil.move(str(src), str(dst))
+            return True, ""
+        except Exception as e:
+            return False, f"shutil.move falhou: {e}"
+
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    cmd = [
+        "robocopy", str(src), str(dst),
+        "/MOVE", "/E", f"/R:{retries}", "/W:2",
+        "/NFL", "/NDL", "/NJH", "/NJS", "/NC", "/NS", "/NP",
+    ]
+    try:
+        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
+    except subprocess.TimeoutExpired:
+        return False, "robocopy timeout (>180s) — provável lock persistente"
+
+    # Códigos: 0=ok(sem arquivos), 1=copied, 2=extra, 3=both,
+    # 4=mismatch, 5=falha ao copiar, 6=extra+falha, 7=both+falha,
+    # 8+=erro fatal (access denied, path inválido etc.)
+    if r.returncode >= 8:
+        return False, (
+            f"robocopy fatal (exit {r.returncode}): "
+            f"{(r.stdout or r.stderr).strip()[-400:]}"
+        )
+
+    # Verifica se sobrou algo
+    if src.exists():
+        leftovers = list(src.iterdir())
+        if leftovers:
+            names = ", ".join(p.name for p in leftovers[:8])
+            more = f" (+{len(leftovers)-8} mais)" if len(leftovers) > 8 else ""
+            return False, (
+                f"robocopy moveu parcialmente. {len(leftovers)} arquivo(s) "
+                f"bloqueado(s) em {src}: {names}{more}"
+            )
+        try:
+            src.rmdir()
+        except Exception:
+            pass
+
+    if not dst.exists():
+        return False, f"destino {dst} não foi criado"
+    return True, ""
+
+
+def _diagnose_vanilla_locks(vanilla: Path) -> str:
+    """Lista o que (provavelmente) segura handles em `vanilla`."""
+    if not vanilla.exists():
+        return "  (vanilla não existe)"
+
+    if sys.platform == "win32":
+        # Tenta renomear cada filho em ordem — o primeiro que falhar é o culpado
+        locked = []
+        for child in vanilla.iterdir():
+            tmp = child.with_name(f"__locktest_{child.name}")
+            try:
+                child.rename(tmp)
+                tmp.rename(child)
+            except Exception as e:
+                locked.append(f"  ✖ {child.name} — {type(e).__name__}: {e}")
+        if locked:
+            return "  Arquivos/folders bloqueados:\n" + "\n".join(locked[:10])
+
+        # Nenhum arquivo individual bloqueado → provavelmente a pasta em si
+        # (CWD de algum processo) ou antivírus
+        ps = (
+            "Get-CimInstance Win32_Process | "
+            "Where-Object { $_.Name -match 'python|cmd|powershell|explorer|lite-xl|MsMpEng' } | "
+            "Select-Object ProcessId,Name,CommandLine | Format-Table -AutoSize"
+        )
+        try:
+            r = subprocess.run(
+                ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
+                capture_output=True, text=True, timeout=10
+            )
+            out = r.stdout.strip()
+            # filtra linhas com .config\lite-xl ou pty_file_daemon
+            suspicious = [ln for ln in out.splitlines()
+                          if ".config\\lite-xl" in ln or "pty_file_daemon" in ln]
+            if suspicious:
+                return "  Processos com handle suspeito:\n  " + "\n  ".join(suspicious[:10])
+            return "  (nenhum processo obviamente culpado — provável antivírus)"
+        except Exception as e:
+            return f"  (diagnóstico falhou: {e})"
+
+    else:
+        try:
+            r = subprocess.run(["lsof", "+D", str(vanilla)],
+                               capture_output=True, text=True, timeout=10)
+            if r.stdout.strip():
+                return r.stdout[:1500]
+        except Exception:
+            pass
+        return f"  (rodar `lsof +D {vanilla}` manualmente)"
