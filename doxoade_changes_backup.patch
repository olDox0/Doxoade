+import ctypes
+
+# ═══════════════════════════════════════════════════════════════
+# 🏛️ ISOLAMENTO DO CANÔNICO (junction + migração)
+# ═══════════════════════════════════════════════════════════════
+_FILE_ATTRIBUTE_REPARSE_POINT = 0x400
+_INVALID_FILE_ATTRIBUTES = 0xFFFFFFFF
+
+def _path_exists_any(p: Path) -> bool:
+    """True se o path existe, incluindo junctions/symlinks quebradas."""
+    try:
+        os.lstat(p)
+        return True
+    except (FileNotFoundError, OSError):
+        return False
+
+def _is_junction_or_symlink(p: Path) -> bool:
+    """Detecta junction (Windows) ou symlink (POSIX), incluindo quebradas."""
+    if not _path_exists_any(p):
+        return False
+    if sys.platform == "win32":
+        try:
+            attrs = ctypes.windll.kernel32.GetFileAttributesW(str(p))
+            if attrs == _INVALID_FILE_ATTRIBUTES:
+                return False
+            return bool(attrs & _FILE_ATTRIBUTE_REPARSE_POINT)
+        except Exception:
+            return p.is_symlink()
+    return p.is_symlink()
+
+def _remove_junction(p: Path) -> bool:
+    """Remove junction/symlink (NÃO recursivo — não toca no alvo)."""
+    try:
+        os.unlink(p)  # junction e symlink: unlink, nunca rmdir
+        return True
+    except Exception:
+        return False
+
+def _create_junction(link: Path, target: Path) -> Tuple[bool, str]:
+    """Cria junction (Windows) ou symlink (POSIX)."""
+    link.parent.mkdir(parents=True, exist_ok=True)
+    if sys.platform == "win32":
+        res = subprocess.run(
+            ["cmd", "/c", "mklink", "/J", str(link), str(target)],
+            capture_output=True, text=True
+        )
+        if res.returncode != 0:
+            return False, f"mklink /J falhou: {res.stderr.strip() or res.stdout.strip()}"
+        return True, f"Junction criada: {link} → {target}"
+    else:
+        try:
+            os.symlink(target, link)
+            return True, f"Symlink criado: {link} → {target}"
+        except Exception as e:
+            return False, f"symlink falhou: {e}"
 
