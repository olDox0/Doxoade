+@lite_xl_group.command("canonical-info", help="🔍 Inspeciona paths do núcleo, junction e estado de isolamento.")
+def cmd_canonical_info():
+    from doxoade.commands.lite_xl_systems.typhon_deploy import TyphonDeployEngine
+    from doxoade.commands.lite_xl_systems.lite_xl_paths import LiteXLPaths
+
+    nucleus = LiteXLPaths.get_canonical_nucleus_dir()
+    vanilla = LiteXLPaths.get_vanilla_litexl_dir()
+    init_file = LiteXLPaths.get_canonical_init_path()
+    isolated = TyphonDeployEngine.is_canonical_isolated()
+
+    print(f"\n{Fore.CYAN}{Style.BRIGHT}🏛️ CANONICAL INFO{Style.RESET_ALL}\n")
+    print(f"  {Fore.WHITE}Núcleo:{Fore.RESET}      {nucleus}")
+    print(f"  {Fore.WHITE}init.lua:{Fore.RESET}    {'✔ ' + str(init_file.stat().st_size) + ' bytes' if init_file.exists() else '✖ ausente'}")
+    print(f"  {Fore.WHITE}Vanilla:{Fore.RESET}     {vanilla}")
+
+    junction_ok = False
+    if vanilla.exists():
+        try:
+            real = Path(os.path.realpath(vanilla))
+            junction_ok = (real == Path(os.path.realpath(nucleus)))
+        except Exception:
+            pass
+
+    status = (
+        f"{Fore.GREEN}✔ ativa{Fore.RESET}" if junction_ok
+        else (f"{Fore.RED}✖ quebrada/ausente{Fore.RESET}" if vanilla.exists() else f"{Fore.YELLOW}⚠ não existe{Fore.RESET}")
+    )
+    print(f"  {Fore.WHITE}Junction:{Fore.RESET}    {status}")
+    print(f"  {Fore.WHITE}Isolado:{Fore.RESET}     {Fore.GREEN + '✔ sim' + Fore.RESET if isolated else Fore.RED + '✖ não' + Fore.RESET}")
+
+    backups = TyphonDeployEngine.list_canonical_backups()
+    print(f"  {Fore.WHITE}Backups:{Fore.RESET}     {len(backups)} em {LiteXLPaths.get_canonical_backups_root()}\n")
+
+def _diagnose_junction(vanilla: Path, nucleus: Path) -> Tuple[str, str]:
+    """Retorna (status_curto, descrição_colorida)."""
+    if not _path_exists_any(vanilla):
+        return "ausente", f"{Fore.YELLOW}⚠ não existe{Fore.RESET}"
+
+    if not _is_junction_or_symlink(vanilla):
+        return "real", f"{Fore.YELLOW}⚠ diretório real (não migrado){Fore.RESET}"
+
+    if not vanilla.exists():
+        return "quebrada", f"{Fore.RED}✖ junction quebrada (alvo inacessível){Fore.RESET}"
+
+    try:
+        real = Path(os.path.realpath(vanilla))
+        target = Path(os.path.realpath(nucleus))
+        if real == target:
+            return "ativa", f"{Fore.GREEN}✔ ativa → {nucleus}{Fore.RESET}"
+        return "divergente", f"{Fore.RED}✖ aponta para {real}{Fore.RESET} (esperado: {nucleus})"
+    except Exception as e:
+        return "erro", f"{Fore.RED}✖ {e}{Fore.RESET}"
+
