+function ConsultDocReaderView:perform_search(query)
+  self.search_query = query or ""
+  self.search_matches = {}
+  self.search_ordered = {}
+  self.search_current = 0
+  if self.search_query == "" then
+    self.search_active = false
+    core.redraw = true
+    return
+  end
+  local needle = self.search_query:lower()
+  local active = self:get_active_lines()
+  for i, line in ipairs(active) do
+    local lower = tostring(line or ""):lower()
+    local spans = {}
+    local start = 1
+    while true do
+      local s, e = lower:find(needle, start, true)
+      if not s then break end
+      table.insert(spans, { s, e })
+      table.insert(self.search_ordered, { line_idx = i, start = s, finish = e })
+      start = e + 1
+    end
+    if #spans > 0 then
+      self.search_matches[i] = spans
+    end
+  end
+  if #self.search_ordered > 0 then
+    self.search_active = true
+    self.search_current = 1
+    self:_scroll_to_match(1)
+  else
+    self.search_active = false
+  end
+  core.redraw = true
+end
+
+function ConsultDocReaderView:_scroll_to_match(idx)
+  local m = self.search_ordered[idx]
+  if not m then return end
+  local target_y = (m.line_idx - 1) * self.line_h
+  local view_h = self.size.y - self.header_h - 40
+  local new_scroll = target_y - math.floor(view_h / 2)
+  if new_scroll < 0 then new_scroll = 0 end
+  self.scroll.y = new_scroll
+end
+
+function ConsultDocReaderView:search_next()
+  if not self.search_active or #self.search_ordered == 0 then return end
+  self.search_current = (self.search_current % #self.search_ordered) + 1
+  self:_scroll_to_match(self.search_current)
+  core.redraw = true
+end
+
+function ConsultDocReaderView:search_prev()
+  if not self.search_active or #self.search_ordered == 0 then return end
+  self.search_current = self.search_current - 1
+  if self.search_current < 1 then
+    self.search_current = #self.search_ordered
+  end
+  self:_scroll_to_match(self.search_current)
+  core.redraw = true
+end
+
+function ConsultDocReaderView:clear_search()
+  self.search_query = ""
+  self.search_matches = {}
+  self.search_ordered = {}
+  self.search_current = 0
+  self.search_active = false
+  core.redraw = true
+end
